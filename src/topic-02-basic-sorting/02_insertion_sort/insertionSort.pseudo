ALGORITHM InsertionSort(A, n)
    INPUT   A: 원소 n개의 배열
    OUTPUT  오름차순으로 정렬된 A

    for i <- 1 to n-1 do
        key <- A[i]                  // 이동 1회
        j <- i-1
        while j >= 0 and A[j] > key do   // A[j] > key 평가마다 비교 1회
            A[j+1] <- A[j]           // 이동 1회 (한 칸 밀기)
            j <- j-1
        A[j+1] <- key                // 이동 1회

// 비교 횟수: A[j] > key를 평가한 횟수. 밀기를 멈추게 한 마지막 평가도 센다
//   최선  n-1        (이미 정렬: 앞 원소와 한 번씩 비교하고 바로 멈춘다)
//   최악  n(n-1)/2   (역순: 매번 끝까지 민다)
// 이동 횟수
//   최선 2(n-1), 최악 n(n-1)/2 + 2(n-1)
