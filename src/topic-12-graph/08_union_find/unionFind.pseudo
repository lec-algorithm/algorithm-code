ALGORITHM KruskalUF(G)
    INPUT   G: 연결된 무방향 가중치 그래프 (정점 V개, 간선 E개)
    OUTPUT  최소 스패닝 트리의 간선들과 총 가중치

    edges <- G의 간선을 (가중치, u, v) 오름차순으로 정렬
    for each 정점 v in G do
        parent[v] <- v                  // 처음에는 저마다 자기 혼자인 트리의 뿌리
        size[v] <- 1
    mst <- 빈 목록
    for each (u, v, w) in edges do
        a <- Find(u), b <- Find(v)
        if a != b then                  // 뿌리가 다르다 = 다른 덩어리 -> 사이클 없음
            mst에 (u, v, w) 추가
            Union(a, b)
            if |mst| = V - 1 then break
        else                            // 뿌리가 같다 = 같은 덩어리 -> 넣으면 사이클
            (u, v)를 버린다
    return mst

ALGORITHM Find(x)                       // x가 속한 트리의 뿌리
    root <- x
    while parent[root] != root do       // 부모를 따라 뿌리까지 올라간다
        root <- parent[root]
    while parent[x] != root do          // 경로 압축: 지나온 정점을 뿌리에 바로 붙인다
        next <- parent[x]
        parent[x] <- root
        x <- next
    return root

ALGORITHM Union(a, b)                   // a, b는 서로 다른 뿌리
    if size[a] < size[b] or (size[a] = size[b] and a > b) then
        swap(a, b)                      // a가 큰 쪽(같으면 번호가 작은 쪽)
    parent[b] <- a                      // 작은 트리를 큰 트리의 뿌리 밑에 단다
    size[a] <- size[a] + size[b]

// comp 배열(03_mst_kruskal)과 다른 점
//   comp  판정 O(1), 합치기는 V칸을 다 훑어 O(V). 합치기가 V-1번이므로 O(V^2)
//   union-find  판정도 합치기도 Find 두 번. 크기로 합치면 트리 높이가 log V를 넘지 않고,
//               경로 압축까지 하면 Find 한 번이 사실상 상수다. 전체는 정렬 O(E log E)에 묶인다
// 세는 값: 따라간 부모 링크 수(links). Find가 x에서 뿌리까지 올라간 간선 수의 합
// 큰 그래프: 정점 v(1 이상)를 앞의 정점 rand(v)에 이어 연결을 보장하고, 나머지 간선은 무작위 두 정점
// 난수: x <- (1664525 x + 1013904223) mod 2^32, rand(k) = x mod k, 시드 2026
