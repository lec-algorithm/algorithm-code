ALGORITHM Prim(G, s)
    INPUT   G: 연결된 무방향 가중치 그래프 (정점 V개, 간선 E개), s: 시작 정점
    OUTPUT  최소 스패닝 트리의 간선들과 총 가중치

    for each 정점 v in G do
        key[v] <- INF                   // 트리에 붙는 가장 가벼운 간선의 가중치
        via[v] <- -1                    // 그 간선의 트리 쪽 끝
        inTree[v] <- false
    key[s] <- 0
    PQ <- 빈 최소 힙
    insert (key[s], s) into PQ
    while PQ가 비어 있지 않고 |mst| < V - 1 동안 do
        (k, u) <- ExtractMin(PQ)        // 지금 트리에 가장 가까운 정점
        if inTree[u] then continue      // 예전에 넣어 둔 낡은 항목은 버린다
        inTree[u] <- true
        if u != s then mst에 (via[u], u, k) 추가
        for each (u, v, w) in adj[u] do
            if not inTree[v] and w < key[v] then
                key[v] <- w             // 더 가벼운 간선을 찾았다
                via[v] <- u
                insert (w, v) into PQ   // 갱신 대신 새로 넣는다
    return mst

// 그리디 선택: 트리와 바깥을 가르는 간선 중 가장 가벼운 것을 고른다(cut 속성).
// 힙에 들어가는 항목은 간선마다 많아야 하나이므로 넣기·꺼내기가 O(E log E)
// = O(E log V)
// 같은 key면 먼저 넣은 항목을 먼저 꺼낸다.
// 가중치는 원래 표의 값에 100을 곱한 정수로 다룬다 (0.16 -> 16)
