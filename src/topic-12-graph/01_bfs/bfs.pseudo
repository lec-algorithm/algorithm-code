ALGORITHM BFS(G, s)
    INPUT   G: 인접 목록으로 표현한 그래프 (정점 0 ~ V-1)
            s: 시작 정점
    OUTPUT  방문 순서, 그리고 정점마다 from(어디서 왔나)과 dist(간선 몇 개)

    for each 정점 v in G do
        marked[v] <- false
        from[v] <- -1
        dist[v] <- INF
    marked[s] <- true                   // 넣을 때 표시한다
    dist[s] <- 0
    Q <- 빈 큐 (FIFO)
    enqueue s into Q
    while Q가 비어 있지 않은 동안 do
        v <- dequeue from Q             // 가장 먼저 들어온 정점
        for each w in adj[v] do         // 편의상 오름차순
            if not marked[w] then
                marked[w] <- true
                from[w] <- v
                dist[w] <- dist[v] + 1  // 한 층 아래
                enqueue w into Q

ALGORITHM PathTo(from, s, t)
    path <- 빈 목록
    x <- t
    while x != -1 do                    // from을 거슬러 s까지 올라간다
        path 앞에 x를 붙인다
        x <- from[x]
    return path

// 큐는 먼저 넣은 것을 먼저 꺼낸다. 그래서 s에서 간선 1개 거리인 정점을
// 모두 꺼낸 뒤에야 2개 거리인 정점을 꺼낸다. 층별로 퍼져 나간다.
// 가중치가 없는 그래프에서 dist[v]는 s에서 v까지의 최단 경로 길이다.
// 정점마다 한 번 꺼내고 간선마다 양 끝에서 한 번씩 보므로 O(V + E)
