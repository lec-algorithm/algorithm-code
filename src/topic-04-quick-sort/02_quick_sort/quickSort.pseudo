ALGORITHM QuickSort(A, lo, hi)
    INPUT   A: 배열, lo..hi: 정렬할 범위
    OUTPUT  오름차순으로 정렬된 A[lo..hi]

    if lo >= hi then return          // 원소 하나면 이미 정렬
    p <- Partition(A, lo, hi)        // 피벗을 제자리에 놓는다
    QuickSort(A, lo, p-1)            // 피벗 왼쪽 (피벗보다 작은 것들)
    QuickSort(A, p+1, hi)            // 피벗 오른쪽 (크거나 같은 것들)

ALGORITHM Partition(A, lo, hi)
    // A[lo]를 피벗으로 삼아, 작은 것은 왼쪽, 나머지는 오른쪽으로
    pivot <- A[lo]
    i <- lo                          // i: 피벗보다 작은 구간의 끝
    for j <- lo+1 to hi do
        if A[j] < pivot then         // 비교 1회
            i <- i + 1
            swap A[i], A[j]          // 이동 3회
    swap A[lo], A[i]                 // 피벗을 경계로. 이동 3회
    return i                         // 피벗의 최종 위치

// 병합 정렬과 반대다. 나눌 때 일하고(파티션), 결합은 공짜다.
// 비교 횟수: 평균 O(n log n). 피벗이 늘 한쪽 끝값이면 최악 O(n^2)
//   이미 정렬된 입력 + 첫 원소 피벗이 정확히 그 최악이다
// 공간: 재귀 스택 O(log n). temp 배열이 없다
