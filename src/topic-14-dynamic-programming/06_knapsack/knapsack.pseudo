// 0/1 배낭: 용량 W인 배낭에 물건을 통째로만 담아 가치의 합을 최대로
//   물건 i는 무게 w[i], 가치 v[i]. 쪼갤 수 없고 한 번만 담을 수 있다.
//   예제: W = 50, 물건 (10, 60) (20, 100) (30, 120) -> 220 (물건 2, 3)
//
// 점화식: dp[i][c] = 물건 1..i만 써서 용량 c에 담을 수 있는 최대 가치
//   dp[0][c] = 0
//   dp[i][c] = dp[i-1][c]                                  w[i] > c   (안 들어간다)
//            = max(dp[i-1][c], dp[i-1][c - w[i]] + v[i])   그 밖     (안 담는다 / 담는다)

ALGORITHM Knapsack(w, v, n, W)
    // 1. 물건이 없으면 가치 0
    for c <- 0 to W do dp[0][c] <- 0
    // 2. 물건을 하나씩 늘려 가며
    for i <- 1 to n do
        for c <- 0 to W do
            dp[i][c] <- dp[i-1][c]                      // 안 담는 경우 (위 칸)
            if w[i] <= c and dp[i-1][c - w[i]] + v[i] > dp[i][c] then
                dp[i][c] <- dp[i-1][c - w[i]] + v[i]    // 담는 경우
    // 3. 경로 복원: 아래에서 위로, 위 칸과 다르면 물건 i를 담은 것
    c <- W
    for i <- n downto 1 do
        if dp[i][c] != dp[i-1][c] then
            take item i
            c <- c - w[i]
    return dp[n][W]

// 표가 (n+1) x (W+1)이므로 시간 O(nW) · 공간 O(nW)
// 주제 06의 그리디(단위 무게당 가치 순)는 물건 1, 2를 담고 160에서 멈췄다.
// 표는 "물건 1을 버리고 2, 3을 담는" 경우까지 빠짐없이 견주므로 220을 찾는다.
