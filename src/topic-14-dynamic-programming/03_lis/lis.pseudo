// 최장 증가 부분수열 (LIS, Longest Increasing Subsequence)
//   배열에서 몇 개를 골라 (순서는 그대로) 순증가하는 가장 긴 수열의 길이
//   [10, 9, 2, 5, 3, 7, 101, 18] -> 4   (예: 2 5 7 101)

ALGORITHM LisHelper(arr, n, i, prev)
    INPUT   i: 지금 볼 원소, prev: 마지막으로 고른 원소의 인덱스 (없으면 -1)
            memo[0..n-1][0..n]: 처음에는 전부 -1
    OUTPUT  arr[i..n-1]에서 더 이을 수 있는 최대 길이

    if i = n then return 0                       // 1. 기저: 더 볼 원소가 없다
    if memo[i][prev+1] != -1 then                // 2. 이미 구한 (i, prev)면 바로
        return memo[i][prev+1]
    exclude <- LisHelper(arr, n, i+1, prev)      // 3. arr[i]를 고르지 않는 경우
    include <- 0
    if prev = -1 or arr[i] > arr[prev] then      //    arr[i]를 고를 수 있으면
        include <- 1 + LisHelper(arr, n, i+1, i) //    고르는 경우
    memo[i][prev+1] <- max(include, exclude)     // 4. 둘 중 큰 것을 적어 둔다
    return memo[i][prev+1]

ALGORITHM LisMemo(arr, n)
    memo를 전부 -1로
    return LisHelper(arr, n, 0, -1)

// 하향식. 원소마다 "고른다 / 안 고른다" 두 갈래라 메모 없이는 O(2^n)이다.
// 부분 문제는 (i, prev) 쌍이므로 많아야 n(n+1)개, 각각 O(1)이라
//   시간 O(n^2) · 공간 O(n^2)
// prev 칸을 인덱스 + 1로 두는 것은 "아직 고른 것 없음"(-1)을 0번 칸에 담기 위해서다.


ALGORITHM LisTab(arr, n)
    OUTPUT  LIS 길이와 그 수열 하나

    for i <- 0 to n-1 do                         // 1. 초기화
        dp[i] <- 1                               //    원소 하나만으로는 길이 1
        prev[i] <- -1
    for i <- 1 to n-1 do                         // 2. 앞의 원소를 모두 훑는다
        for j <- 0 to i-1 do
            if arr[j] < arr[i] and dp[j] + 1 > dp[i] then
                dp[i] <- dp[j] + 1               //    arr[j]로 끝나는 수열 뒤에 arr[i]를 잇는다
                prev[i] <- j
    end <- dp가 가장 큰 첫 인덱스                // 3. 최댓값 찾기
    end부터 prev를 따라가며 거꾸로 모은다       // 4. 경로 복원
    return dp[end]

// 상향식. dp[i] = arr[i]로 끝나는 가장 긴 증가 부분수열의 길이
//   dp[i] = 1 + max { dp[j] : j < i, arr[j] < arr[i] }   (그런 j가 없으면 1)
// 칸 하나를 채울 때 앞의 칸을 전부 보므로 시간 O(n^2) · 공간 O(n)
// (이진 검색을 섞으면 O(n log n)까지 줄일 수 있다)
