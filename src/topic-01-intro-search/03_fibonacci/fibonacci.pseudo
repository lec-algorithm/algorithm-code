// 피보나치 수열
//   F(0) = 0
//   F(1) = 1
//   F(n) = F(n-1) + F(n-2)    n > 1

ALGORITHM FibonacciRecursive(n)
    INPUT   n: 구하려는 항의 번호
    OUTPUT  F(n)

    if n <= 1 then
        return n
    return FibonacciRecursive(n-1) + FibonacciRecursive(n-2)

// 정의를 그대로 옮긴 형태다. 읽기는 가장 쉽다.
// 그런데 F(n-1)과 F(n-2)가 각각 다시 갈라지므로 호출이 나무처럼 퍼진다.
// 같은 항을 몇 번이고 다시 계산한다: F(5)를 구하는 동안 F(2)를 세 번 계산한다.
//   시간 O(2^n) · 공간 O(n)   (호출 스택의 깊이)


ALGORITHM FibonacciIterative(n)
    INPUT   n: 구하려는 항의 번호
    OUTPUT  F(n)

    if n <= 1 then
        return n

    prev <- 0        // F(0)
    curr <- 1        // F(1)

    for i <- 2 to n do
        next <- prev + curr
        prev <- curr
        curr <- next

    return curr

// 앞의 두 항만 있으면 다음 항이 나온다. 그 둘만 들고 앞으로 나아간다.
// 각 항을 정확히 한 번씩만 계산한다.
//   시간 O(n) · 공간 O(1)
