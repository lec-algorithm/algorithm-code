ALGORITHM CosineSimilarity(a, b, n)
    INPUT   a, b: 평점 벡터 n칸 (0은 아직 안 본 것)
    OUTPUT  두 벡터 사이 각도의 코사인 (-1 ~ 1, 평점이 모두 양수면 0 ~ 1)

    dot <- 0,  na <- 0,  nb <- 0
    for i <- 0 to n-1 do
        dot <- dot + a[i] * b[i]
        na <- na + a[i] * a[i]
        nb <- nb + b[i] * b[i]
    if na = 0 or nb = 0 then return 0
    return dot / (sqrt(na) * sqrt(nb))

ALGORITHM PearsonSimilarity(a, b, n)
    INPUT   a, b: 평점 벡터 n칸 (0은 아직 안 본 것)
    OUTPUT  둘 다 본 아이템에서 잰 상관계수 (-1 ~ 1)

    common <- a[i] > 0 이고 b[i] > 0 인 i들   // 둘 다 본 아이템만
    if common이 비었으면 return 0
    ma <- common에서 a의 평균,  mb <- common에서 b의 평균
    num <- 0,  da <- 0,  db <- 0
    for i in common do                       // 각자의 평균을 빼고 잰다
        num <- num + (a[i] - ma) * (b[i] - mb)
        da <- da + (a[i] - ma)^2
        db <- db + (b[i] - mb)^2
    if da = 0 or db = 0 then return 0
    return num / sqrt(da * db)

ALGORITHM TopNeighbors(sim, m, skip, k)
    OUTPUT  sim이 0보다 큰 것 중 큰 순서로 최대 k개 (skip은 자기 자신)

    neighbors <- []
    while neighbors의 길이 < k do
        best <- sim[v] > 0 이고 아직 안 고른 v 중 sim[v]가 가장 큰 것 (v ≠ skip)
        if best가 없으면 break
        neighbors에 best 추가
    return neighbors

ALGORITHM PredictUserBased(R, sim, neighbors, item)
    INPUT   R: 사용자 × 아이템 평점 행렬, sim[v]: 대상 사용자와 v의 유사도
    OUTPUT  대상 사용자가 item에 줄 평점의 예측값

    num <- 0,  den <- 0
    for v in neighbors do
        if R[v][item] > 0 then               // 이웃이 본 아이템이면
            num <- num + sim[v] * R[v][item] // 비슷할수록 크게 반영
            den <- den + sim[v]
    if den = 0 then return 0
    return num / den                         // 유사도로 가중한 평균

ALGORITHM PredictItemBased(R, m, n, target, item, k)
    OUTPUT  target이 이미 평가한 아이템들로 item의 평점을 예측한 값

    for j <- 0 to n-1 do                     // 열(아이템)끼리 비교한다
        if R[target][j] > 0 then sim[j] <- CosineSimilarity(R의 item 열, R의 j 열, m)
        else sim[j] <- 0                     // target이 안 본 아이템은 근거가 못 된다
    near <- TopNeighbors(sim, n, item, k)
    return near에 대해 sim[j] * R[target][j]의 합 / sim[j]의 합

// 사용자 m명, 아이템 n개일 때
// 유사도 하나: O(n),  대상 사용자 한 명과 나머지 전부: O(mn)
// 아이템 기반에서 아이템 하나와 나머지 전부: O(mn)
// 모든 쌍의 유사도를 미리 구해 두면 사용자 기반 O(m^2 n), 아이템 기반 O(n^2 m)
