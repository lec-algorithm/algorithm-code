ALGORITHM BuildSuffixArrayNaive(T, n)
    INPUT   T: 길이 n의 문자열. 끝에 다른 어떤 문자보다 작은 '$'를 붙여 둔다
    OUTPUT  SA: 접미사 T[SA[0]..], T[SA[1]..], ...가 사전순이 되는 시작 위치 배열

    for i <- 0 to n-1 do SA[i] <- i
    SA를 정렬한다. 비교 기준: 접미사 T[SA[a]..]와 T[SA[b]..]의 사전순
    return SA

// 비교 정렬이 O(n log n)번 비교하고, 비교 한 번이 최대 n글자를 본다: O(n^2 log n)

ALGORITHM BuildSuffixArrayDoubling(T, n)
    INPUT   T, n: 위와 같다
    OUTPUT  SA

    for i <- 0 to n-1 do
        rank[i] <- T[i]                    // 처음 순위는 첫 글자의 문자 코드
        SA[i] <- i

    k <- 2
    loop
        // 앞 k/2글자의 순위와, k/2칸 뒤에서 시작하는 다음 k/2글자의 순위를 짝 짓는다
        // 이 짝을 비교하면 앞 k글자를 비교한 것과 같다
        for i <- 0 to n-1 do
            key[i] <- (rank[i], i + k/2 < n이면 rank[i + k/2], 아니면 -1)

        SA를 key[SA[j]] 순으로 정렬한다 (key가 같으면 시작 위치 순)

        // 정렬된 순서대로 새 순위를 매긴다. key가 같으면 같은 순위
        newRank[SA[0]] <- 0
        for j <- 1 to n-1 do
            if key[SA[j]] = key[SA[j-1]] then newRank[SA[j]] <- newRank[SA[j-1]]
            else newRank[SA[j]] <- newRank[SA[j-1]] + 1
        rank <- newRank

        if rank[SA[n-1]] = n-1 then break  // 순위가 모두 다르면 끝
        k <- k * 2                         // 2 -> 4 -> 8 -> ... 글자
    return SA

// 라운드는 많아야 log n번. 라운드마다 정수 짝을 비교 정렬하면 O(n log n)
// 전체 O(n log^2 n). 짝 정렬을 기수 정렬(두 자리 LSD)로 바꾸면 O(n log n)
