ALGORITHM LongestCommonSubstring(S1, S2)
    INPUT   S1, S2: 문자열 두 개 ('#'와 '$'는 들어 있지 않다)
    OUTPUT  S1과 S2에 함께 나오는 가장 긴 부분 문자열

    T <- S1 + "#" + S2 + "$"              // 하나로 이어 붙인다. n = |T|
    SA <- BuildSuffixArray(T, n)          // 03_suffix_array
    LCP <- BuildLcpKasai(T, SA, n)        // 04_lcp

    // 접미사가 어느 문자열에서 시작했는지
    //   위치 < |S1|이면 1, '#'나 '$' 자리면 0, 나머지는 2
    best <- 0, at <- 0
    for j <- 1 to n-1 do
        f <- Origin(SA[j]), g <- Origin(SA[j-1])
        if f ≠ 0 and g ≠ 0 and f ≠ g then // 서로 다른 문자열에서 시작한 이웃만
            if LCP[j] > best then
                best <- LCP[j], at <- j
    return T[SA[at] .. SA[at] + best - 1]

// '#'는 T에 한 번만 나오므로 S1 쪽 접미사와 S2 쪽 접미사의 공통 접두사는 '#'를
// 넘어가지 못한다. 그래서 LCP가 곧 두 문자열의 공통 부분 문자열 길이다
// 같은 문자열끼리의 이웃(LRS 후보)은 건너뛴다
// 시간 O(n log n) (접미사 배열) + O(n) (LCP와 훑기), n = |S1| + |S2| + 2
