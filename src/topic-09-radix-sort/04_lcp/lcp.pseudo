ALGORITHM BuildLcpKasai(T, SA, n)
    INPUT   T: 길이 n의 문자열('$'로 끝남), SA: T의 접미사 배열
    OUTPUT  LCP: LCP[j]는 접미사 T[SA[j-1]..]와 T[SA[j]..]의 최장 공통 접두사 길이
            LCP[0]은 앞 이웃이 없으므로 정의하지 않는다

    // 1단계: SA의 역함수. rank[i]는 위치 i에서 시작하는 접미사가 정렬에서 몇 번째인지
    for j <- 0 to n-1 do
        rank[SA[j]] <- j

    // 2단계: 텍스트 위치 순서(i = 0, 1, 2, ...)로 접미사를 하나씩 처리한다
    h <- 0                                  // 지금 알고 있는 공통 접두사 길이
    for i <- 0 to n-1 do
        if rank[i] > 0 then
            j <- SA[rank[i] - 1]            // 정렬에서 바로 앞에 있는 접미사의 시작 위치
            // h글자는 이미 같다고 알고 있으므로 h번째 글자부터 비교한다
            while i + h < n and j + h < n and T[i + h] = T[j + h] do
                h <- h + 1
            LCP[rank[i]] <- h
            // 다음 위치 i+1의 접미사는 이 접미사에서 첫 글자를 뗀 것이다
            // 그 앞 이웃과는 적어도 h-1글자를 공유한다
            if h > 0 then h <- h - 1
        else
            h <- 0                          // 맨 앞 접미사는 비교할 이웃이 없다

// h는 1씩만 줄고 n을 넘지 않으므로 while의 h 증가는 모두 합쳐 2n번 이하: O(n)
// 이웃 쌍마다 처음부터 비교하면 최악 O(n^2)
