ALGORITHM LongestRepeatedSubstring(T, n)
    INPUT   T: 길이 n의 문자열('$'로 끝남)
    OUTPUT  T에 두 번 이상 나오는 가장 긴 부분 문자열

    SA <- BuildSuffixArray(T, n)          // 03_suffix_array
    LCP <- BuildLcpKasai(T, SA, n)        // 04_lcp

    // 반복되는 부분 문자열은 두 접미사의 공통 접두사다
    // 정렬하면 공통 접두사가 긴 접미사끼리 이웃하므로 이웃 쌍만 보면 된다
    best <- 0, at <- 0
    for j <- 1 to n-1 do
        if LCP[j] > best then
            best <- LCP[j], at <- j
    return T[SA[at] .. SA[at] + best - 1]

ALGORITHM LrsBruteForce(T, n)
    // 비교용: 시작 위치 쌍 (i, j)를 모두 본다
    best <- 0
    for i <- 0 to n-1 do
        for j <- i+1 to n-1 do
            h <- T[i..]와 T[j..]의 공통 접두사 길이
            if h > best then best <- h, start <- i
    return T[start .. start + best - 1]

// 무차별 대입: 쌍이 n(n-1)/2개, 쌍마다 최대 D글자(D: 답의 길이) 비교 -> 최대 D n^2
// 접미사 정렬: 접미사 배열 O(n log n) + LCP O(n) + 최댓값 O(n)
