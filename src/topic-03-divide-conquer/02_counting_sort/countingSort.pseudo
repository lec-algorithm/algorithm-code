ALGORITHM CountingSort(A, n, k)
    INPUT   A: 0 이상 k 이하의 정수 n개
    OUTPUT  오름차순으로 정렬된 새 배열 B

    // 1) 세기: 값마다 몇 개 있는지
    for v <- 0 to k do count[v] <- 0
    for i <- 0 to n-1 do
        count[A[i]] <- count[A[i]] + 1

    // 2) 누적: 값 v가 끝나는 위치(개수 합)
    for v <- 1 to k do
        count[v] <- count[v] + count[v-1]

    // 3) 배치: 뒤에서부터 읽어 제자리에 놓는다
    for i <- n-1 downto 0 do
        count[A[i]] <- count[A[i]] - 1
        B[count[A[i]]] <- A[i]       // 이동 1회

// 원소끼리 비교하지 않는다. 비교 횟수 0
// 시간 O(n + k), 공간 O(n + k)
// 뒤에서부터 읽으므로 같은 값의 순서가 유지된다: 안정
