{
  // 이 저장소는 고정된 진입점이 없다. 주제 폴더마다 예제가 있으므로,
  // 작업도 "열려 있는 파일"을 대상으로 한다.
  //
  // 기본 "C/C++: gcc 활성 파일 빌드"는 파일 하나만 컴파일해
  // `undefined reference`로 실패한다. 아래 작업은 Makefile을 거치므로
  // 같은 폴더의 .c가 함께 빌드된다.
  "version": "2.0.0",
  "tasks": [
    {
      "label": "빌드 (현재 파일)",
      "type": "shell",
      "command": "make ${relativeFileDirname}/${fileBasenameNoExtension}.out",
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": ["$gcc"],
      "presentation": { "reveal": "always", "panel": "shared", "clear": true }
    },
    {
      // launch.json의 "C 디버그 (현재 파일)"이 실행 전에 부르는 작업.
      "label": "make debug (현재 파일)",
      "type": "shell",
      "command": "make ${relativeFileDirname}/${fileBasenameNoExtension}.debug.out",
      "problemMatcher": ["$gcc"],
      "presentation": { "reveal": "silent", "panel": "shared" }
    },
    {
      "label": "make clean",
      "type": "shell",
      "command": "make clean",
      "problemMatcher": [],
      "presentation": { "reveal": "silent", "panel": "shared" }
    }
  ]
}
